{
  "entities": {
    "student": {
      "title": "Student",
      "description": "Information about a student registered in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The RFID UID of the student's card." },
        "name": { "type": "string", "description": "The full name of the student." },
        "studentId": { "type": "string", "description": "The official student ID number." },
        "email": { "type": "string", "format": "email", "description": "Student's contact email." },
        "photoUrl": { "type": "string", "description": "URL to student's profile picture." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the student was registered." }
      },
      "required": ["uid", "name", "studentId"]
    },
    "attendance": {
      "title": "Attendance Log",
      "description": "A record of a student tapping their card.",
      "type": "object",
      "properties": {
        "studentUid": { "type": "string", "description": "The RFID UID of the student." },
        "studentName": { "type": "string", "description": "Denormalized name for quick display." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the tap occurred." },
        "status": { "type": "string", "enum": ["PRESENT", "LATE", "ABSENT"], "description": "Attendance status." },
        "deviceId": { "type": "string", "description": "ID of the ESP32 device that recorded the tap." }
      },
      "required": ["studentUid", "timestamp", "status"]
    },
    "raw_tap": {
      "title": "Raw RFID Tap",
      "description": "The raw data sent by the ESP32 before processing.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "deviceId": { "type": "string" }
      },
      "required": ["uid", "timestamp"]
    },
    "user": {
      "title": "Admin User",
      "description": "System administrator or teacher.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "teacher"] },
        "name": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "student",
      "description": "List of all registered students."
    },
    "/attendance/{logId}": {
      "schema": "attendance",
      "description": "Real-time attendance logs."
    },
    "/raw_taps/{tapId}": {
      "schema": "raw_tap",
      "description": "Unprocessed taps from ESP32."
    },
    "/users/{userId}": {
      "schema": "user",
      "description": "Admin and teacher user profiles."
    }
  }
}
